{
  "name": "hkbp-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "yarn workspace @hkbp/api dev",
    "dev:admin": "yarn workspace @hkbp/admin dev",
    "build": "yarn workspaces run build",
    "db:generate": "yarn workspace @hkbp/api prisma generate",
    "db:migrate": "yarn workspace @hkbp/api prisma migrate dev",
    "db:seed": "yarn workspace @hkbp/api prisma db seed"
  }
}
